# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ALLOWED_CHAT_ID=your_telegram_numeric_user_id

# DeepSeek API (agent LLM) — necessario solo se LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API (Whisper voice transcription only)
OPENAI_API_KEY=your_openai_api_key_here

# Shop session cookie secret (optional, defaults to dev value)
SHOP_SECRET_KEY=change_me_in_production

# Modello AI: "lmstudio" (locale) oppure "deepseek" (cloud)
# Per usare LM Studio in locale:
LLM_PROVIDER=lmstudio
LLM_MODEL_ID=qwen3.5-9b
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Per usare DeepSeek cloud, sostituire con:
# LLM_PROVIDER=deepseek
# LLM_MODEL_ID=deepseek-reasoner
